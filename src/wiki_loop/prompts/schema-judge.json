{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CounterfactualJudgeOutput",
  "type": "object",
  "required": ["assessments"],
  "properties": {
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["session_id", "would_improve"],
        "properties": {
          "session_id": { "type": "string" },
          "would_improve": { "type": "boolean" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
