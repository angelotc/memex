{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WikiMaintainerOutput",
  "type": "object",
  "required": ["patterns", "summary"],
  "properties": {
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "slug", "title"],
        "properties": {
          "action": { "type": "string", "enum": ["create", "merge", "supersede"] },
          "existing_id": { "type": ["string", "null"] },
          "slug": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
          "title": { "type": "string" },
          "kind": { "type": "string", "enum": ["failure", "success"] },
          "scope": { "type": "string" },
          "symptom": { "type": "string" },
          "root_cause": { "type": "string" },
          "fix": { "type": "string" },
          "evidence_session_ids": { "type": "array", "items": { "type": "string" } },
          "evidence_summary": { "type": "string" }
        }
      }
    },
    "summary": { "type": "string", "minLength": 1 }
  }
}
